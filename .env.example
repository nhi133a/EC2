# Copy file này thành ".env" và điền thông tin thật của bạn vào

# --- Thông tin kết nối MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=api_data_db

# --- Thông tin API cần lấy data ---
# Ví dụ dùng API công khai JSONPlaceholder để test
API_URL=https://jsonplaceholder.typicode.com/posts
